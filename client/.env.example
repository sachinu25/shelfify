# Optional. By default the client calls the API on the same origin at /api/v1
# (Vite dev proxy locally, Vercel rewrite in production) — leave unset for that setup.
# Only set this if the API is hosted on a different domain (then also set
# COOKIE_SAMESITE=none and CORS_ORIGINS on the server).
# VITE_API_URL=https://api.example.com/api/v1
