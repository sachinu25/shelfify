{
  "name": "shelfify-server",
  "version": "2.0.0",
  "private": true,
  "description": "Shelfify REST API - Express, MongoDB, Razorpay",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "lint": "node --check src/server.js",
    "dev:local": "node scripts/dev-local.js",
    "db:check": "node scripts/check-db.js",
    "prod:init": "node scripts/prod-init.js",
    "prod:env": "node scripts/prod.js env",
    "prod:db": "node scripts/prod.js db",
    "prod:seed:plan": "node scripts/prod.js seed --plan",
    "prod:seed": "node scripts/prod.js seed",
    "prod:set-mongo": "node scripts/prod-set-mongo.js",
    "prod:redis": "node scripts/prod.js redis",
    "prod:set-redis": "node scripts/prod-set-redis.js",
    "prod:admin-check": "node scripts/prod.js admin",
    "prod:verify-seed": "node scripts/prod.js verify-seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mongoose": "^8.24.9",
    "nodemailer": "^10.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@10.4.3": true
  }
}
