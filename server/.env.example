# ---------------------------------------------------------------------------
# Shelfify API configuration. Copy to server/.env for local development.
# In production (Vercel) set these in Project Settings -> Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# Production semantics apply when NODE_ENV=production OR when running on Vercel
# (the platform sets VERCEL=1). In production the API refuses to start unless
# MONGODB_URI, a strong JWT_ACCESS_SECRET and an https CLIENT_URL are set.
NODE_ENV=development
PORT=5000
# LOG_LEVEL=info

# --- Required in production ------------------------------------------------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Create the
# cluster in AWS Mumbai (ap-south-1) to match the Vercel function region (bom1).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelfify?retryWrites=true&w=majority
# 32+ random characters (placeholders are rejected), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Optional locally: without it a random per-process secret is used.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Seconds in which a just-rotated refresh token may be re-sent by another tab of
# the same browser (multi-tab session restore). 0 disables the grace window.
# REFRESH_REUSE_GRACE_SECONDS=30

# Public URL of the storefront (used in emails and CORS); must be https:// in
# production. Comma-separate extra origins in CORS_ORIGINS.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://shelfify.vercel.app,https://www.example.com
# lax (default, same-origin deployment) | none (only if SPA and API are on different sites)
# COOKIE_SAMESITE=lax

# --- Payments (Razorpay) -------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> secret for https://<your-domain>/api/v1/payments/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# --- Email (optional; without it emails are rendered and logged only) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shelfify <no-reply@yourdomain.com>"

# --- Shared cache + distributed rate limiting (strongly recommended on Vercel) --
# Upstash: Console -> Redis -> your database -> "Connect" -> ioredis/TCP tab,
# copy the rediss://default:<password>@<host>:6379 URL (choose region ap-south-1).
# Without it, rate limits and caches are per serverless instance only.
REDIS_URL=

# --- Scheduled maintenance -----------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". The job releases expired
# reservations and retries interrupted fulfilment, confirmation emails and refunds.
# The same secret unlocks detailed GET /api/health output.
CRON_SECRET=

# --- Vercel only ----------------------------------------------------------------
# Disables Vercel's request helpers so the payment webhook HMAC is computed over
# the untouched raw body (verified to work either way; this is defence in depth).
# NODEJS_HELPERS=0

# --- Business rules -------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FEE=50
ORDER_RESERVATION_MINUTES=30

# --- Seed script only (npm run seed) -------------------------------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Store Admin
