# ---------------------------------------------------------------------------
# Shelfify API configuration. Copy to server/.env for local development.
# In production (Vercel) set these in Project Settings -> Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
# LOG_LEVEL=info

# --- Required in production ------------------------------------------------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelfify?retryWrites=true&w=majority
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Public URL of the storefront (used in emails and CORS). Comma-separate extra origins in CORS_ORIGINS.
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://shelfify.vercel.app,https://www.example.com
# lax (default, same-origin deployment) | none (only if SPA and API are on different sites)
# COOKIE_SAMESITE=lax

# --- Payments (Razorpay) -------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> secret for https://<your-domain>/api/v1/payments/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# --- Email (optional; without it emails are rendered and logged only) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shelfify <no-reply@yourdomain.com>"

# --- Caching / rate limiting (optional, e.g. Upstash Redis rediss:// URL) -----
REDIS_URL=

# --- Scheduled jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ----
CRON_SECRET=

# --- Business rules -------------------------------------------------------------
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FEE=50
ORDER_RESERVATION_MINUTES=30

# --- Seed script only (npm run seed) -------------------------------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Store Admin
