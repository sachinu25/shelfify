{
  "name": "shelfify",
  "version": "2.0.0",
  "private": true,
  "description": "Shelfify — MERN bookstore: React (Vite) client + Express/MongoDB API, deployed as one Vercel project",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:api": "npm run dev --prefix server",
    "dev:api:memory": "npm run dev:memory --prefix server",
    "dev:web": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix server",
    "seed": "npm run seed --prefix server",
    "db:check": "npm run db:check --prefix server",
    "prod:init": "npm run prod:init --prefix server",
    "prod:env": "npm run prod:env --prefix server",
    "prod:db": "npm run prod:db --prefix server",
    "prod:seed:plan": "npm run prod:seed:plan --prefix server",
    "prod:set-mongo": "npm run prod:set-mongo --prefix server",
    "prod:redis": "npm run prod:redis --prefix server",
    "prod:set-redis": "npm run prod:set-redis --prefix server"
  }
}
